# Copy to .env for local development. Variables already set in the
# environment take precedence over this file.

PORT=3001
DATABASE_URL=postgres://localhost/maintenance_chain_node_api_development

# Signs login tokens: a random string of at least 32 characters, e.g. the
# output of `openssl rand -hex 32`. Not the Rails app's secret, which is public.
JWT_SECRET=

# Browser origins allowed to call the API, comma-separated. Defaults to the
# Rails app's list (localhost:3005 and the surge.sh / maintenancecha.in sites).
# CORS_ORIGINS=http://localhost:3005

# Behind a proxy or load balancer: how many there are (or their addresses), so
# rate limiting counts each client's IP rather than the proxy's.
# TRUST_PROXY=1
